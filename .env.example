# D4Tech Hub — contoh variabel lingkungan (salin ke .env untuk lokal,
# atau isi di dashboard Vercel/Render untuk production).
# Semua variabel bersifat OPSIONAL — tanpa ini app tetap jalan
# dengan fallback file + tanpa Sentry.

# --- Persistensi eksternal (Upstash Redis) ---
# Buat database gratis di https://upstash.com lalu isi:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# REDIS_KEY=d4tech:db:v1

# --- Error monitoring (Sentry, opsional) ---
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# --- URL publik (untuk canonical + sitemap) ---
# APP_URL=https://d4tech-hubv2.vercel.app

# --- Server ---
# PORT=3000
